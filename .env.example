# Use credentials from the Supabase project selected for this environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Paystack hosted checkout: use your test secret key for local development.
# Server-only: never expose this secret through a NEXT_PUBLIC_ variable.
PAYSTACK_SECRET_KEY=
# Update the port to match the URL printed by `pnpm dev`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email via SMTP. Keep every value server-only.
# Gmail example: smtp.gmail.com on port 465 with a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
