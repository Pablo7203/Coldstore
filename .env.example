# Use credentials from the Supabase project selected for this environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Paystack hosted checkout: use your test secret key for local development.
# Server-only: never expose this secret through a NEXT_PUBLIC_ variable.
PAYSTACK_SECRET_KEY=
# Update the port to match the URL printed by `pnpm dev`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email via Resend. Use a sender address on a verified domain.
# These values are server-only. Leave blank until the email provider is configured.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
